{
  "name": "cleanee",
  "productName": "Cleanee",
  "version": "1.4.7",
  "description": "Beautiful PC cleaner for Windows",
  "author": "Cleanee",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5288 && cross-env VITE_DEV_SERVER_URL=http://localhost:5288 electron .\"",
    "dist:win": "npm run build && electron-builder --win --x64",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "app.cleanee.desktop",
    "productName": "Cleanee",
    "copyright": "Copyright © 2026 Cleanee",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/Cleanee.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${arch}-${os}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cleanee",
      "installerLanguages": [
        "ja_JP"
      ],
      "language": "1041",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerIcon": "build/icons/Cleanee.ico",
      "uninstallerIcon": "build/icons/Cleanee.ico",
      "installerHeaderIcon": "build/icons/Cleanee.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icons/Cleanee.icns"
    }
  }
}
